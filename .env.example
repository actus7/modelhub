# Copie para .env e preencha. Nunca commite credenciais reais.

# ─── Obrigatórias ──────────────────────────────────────────────
# Neon Postgres (use o endpoint -pooler em produção)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Neon Auth
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="gere-com-openssl-rand-base64-32"

# Criptografia das credenciais de provedores (64 caracteres hex: openssl rand -hex 32)
ENCRYPTION_KEY=""

# ─── Opcionais ─────────────────────────────────────────────────
# REQUIRE_AUTH="true"
# ALLOWED_ORIGINS="https://seu-dominio.com"
# ALLOW_DEBUG_ENDPOINTS="false"
# ENABLED_PROVIDERS="openai,groq"      # se definido, só estes ficam ativos
# DISABLED_PROVIDERS="perplexity"
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX="120"
# USER_RATE_LIMIT_MAX="60"
# UPSTASH_REDIS_REST_URL="https://..."  # rate limit distribuído (as duas juntas)
# UPSTASH_REDIS_REST_TOKEN="..."
# AUTO_ROUTING_CANDIDATE_TIMEOUT_MS="20000"
# MODELHUB_ALLOW_INSECURE_MCP="false"

# ─── Chaves compartilhadas de provedores (opcional) ────────────
# Definir uma chave aqui libera o provedor para todos os usuários.
# Sem ela, cada usuário conecta a própria chave em /dashboard/credentials.
