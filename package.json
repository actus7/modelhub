{
  "name": "modelhub",
  "version": "2.0.0",
  "description": "Hub unificado para múltiplos modelos de IA com API compatível OpenAI, chat integrado e gerenciamento de credenciais",
  "author": "ModelHub Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/actus7/modelhub.git"
  },
  "bugs": {
    "url": "https://github.com/actus7/modelhub/issues"
  },
  "homepage": "https://github.com/actus7/modelhub#readme",
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "google",
    "gemini",
    "chat",
    "api",
    "gateway",
    "proxy",
    "nextjs",
    "typescript",
    "prisma",
    "neon",
    "vercel"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "next build",
    "predev": "pnpm prisma:generate",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:push": "prisma db push --config prisma.config.ts",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "vercel:env:pull": "vercel env pull .env.local -y --environment development",
    "vercel:env:pull:preview": "vercel env pull .env.vercel.preview.local -y --environment preview",
    "vercel:env:pull:production": "vercel env pull .env.vercel.production.local -y --environment production"
  },
  "dependencies": {
    "@babel/standalone": "^8.1.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@neondatabase/auth": "0.7.0-beta",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.18",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.72.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "better-auth": "^1.7.22",
      "@better-auth/core": "^1.7.22",
      "zod@<4.6.6": "^4.6.7",
      "fast-uri@<3.1.9": "^3.1.9",
      "source-map-js@<1.2.2": "^1.2.2",
      "browserslist@<4.28.7": "^4.28.7"
    }
  }
}
