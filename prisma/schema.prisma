generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys              ApiKey[]
  providerCredentials  ProviderCredential[]
  cloudConnections     CloudConnection[]
  cloudDeployments     CloudDeployment[]
  usageLogs            UsageLog[]
  conversations        Conversation[]
  projects             Project[]
  agentRuns            AgentRun[]
  harnessPluginConfigs HarnessPluginConfig[]
  harnessSkills        HarnessSkill[]
  mcpServers           McpServer[]
  toolApprovals        ToolApproval[]
  settings             UserSettings?
  memories             UserMemory[]
  routingConfig        RoutingConfig?
  budget               UserBudget?
}

model Project {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  files         ProjectFile[]
  artifacts     ProjectArtifact[]
  harnessSkills HarnessSkill[]

  @@index([userId, updatedAt])
}

model ProjectFile {
  id             String   @id @default(cuid())
  projectId      String
  fileName       String
  mimeType       String
  byteSize       Int
  blob           Bytes
  extractedText  String?
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions ProjectFileVersion[]

  @@index([projectId])
  @@unique([projectId, fileName])
}

model ProjectFileVersion {
  id            String   @id @default(cuid())
  projectFileId String
  version       Int
  mimeType      String
  byteSize      Int
  blob          Bytes
  extractedText String?
  createdAt     DateTime @default(now())

  projectFile ProjectFile @relation(fields: [projectFileId], references: [id], onDelete: Cascade)

  @@unique([projectFileId, version])
  @@index([projectFileId, createdAt])
}

model ProjectArtifact {
  id                   String   @id @default(cuid())
  projectId            String
  sourceConversationId String?
  sourceCanvasId       String?
  title                String
  kind                 String // CanvasKind: markdown | code | html | react | mermaid
  language             String?
  currentVersion       Int      @default(1)
  shareToken           String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation("ArtifactSourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceCanvas Canvas?           @relation("ArtifactSourceCanvas", fields: [sourceCanvasId], references: [id], onDelete: SetNull)
  versions     ArtifactVersion[]

  @@index([projectId, updatedAt])
}

model ArtifactVersion {
  id         String   @id @default(cuid())
  artifactId String
  version    Int
  content    String
  createdAt  DateTime @default(now())

  artifact ProjectArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([artifactId, version])
}

model Canvas {
  id             String   @id @default(cuid())
  conversationId String
  title          String
  kind           String // CanvasKind: markdown | code | html | react | mermaid
  language       String?
  content        String
  activeVersion  Int      @default(1)
  shareToken     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  versions        CanvasVersion[]
  pinnedArtifacts ProjectArtifact[] @relation("ArtifactSourceCanvas")

  @@index([conversationId, updatedAt])
}

model CanvasVersion {
  id        String   @id @default(cuid())
  canvasId  String
  version   Int
  kind      String
  language  String?
  content   String
  createdAt DateTime @default(now())

  canvas Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@unique([canvasId, version])
}

model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  prefix     String
  label      String    @default("default")
  userId     String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageLogs UsageLog[]

  @@index([key])
  @@index([userId])
}

model ProviderCredential {
  id              String   @id @default(cuid())
  userId          String
  providerId      String
  credentialKey   String
  credentialValue String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId, credentialKey])
  @@index([userId, providerId])
}

model CloudConnection {
  id                       String   @id @default(cuid())
  userId                   String
  provider                 String
  label                    String   @default("Render")
  token                    String
  externalUserId           String?
  externalUserEmail        String?
  externalOrganizationId   String?
  externalOrganizationName String?
  modelhubApiKey           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments CloudDeployment[]

  @@unique([userId, provider])
  @@index([userId, provider])
}

model CloudDeployment {
  id                   String   @id @default(cuid())
  userId               String
  connectionId         String
  provider             String
  name                 String
  status               String
  externalAppId        String
  externalAppName      String
  externalServiceId    String
  externalDeploymentId String?
  publicUrl            String?
  image                String
  region               String
  instanceType         String
  port                 Int
  error                String?
  config               Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection CloudConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([userId, provider])
  @@index([userId, status])
}

model UsageLog {
  id              String   @id @default(cuid())
  userId          String
  apiKeyId        String?
  providerId      String
  modelId         String?
  endpoint        String?
  statusCode      Int      @default(200)
  /// Trecho da resposta de erro (JSON/texto) para diagnóstico no dashboard; ausente em sucessos e em logs antigos.
  errorDetail     String?
  inputTokens     Int?
  outputTokens    Int?
  costUsd         Float?
  durationMs      Int?
  routingTier     String?
  routingReason   String?
  taskCategory    String?
  baselineModelId String?
  baselineCostUsd Float?
  conversationId  String?
  /// Não é único: cada tentativa de fallback entre provedores gera sua própria linha para a mesma mensagem.
  messageId       String?
  /// Tempo até o primeiro byte do stream upstream (TTFT), em ms.
  ttftMs          Int?
  /// Tentativas de fallback entre provedores: [{ providerId, modelId, status, durationMs?, errorSnippet }].
  attempts        Json?
  createdAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([apiKeyId])
  @@index([conversationId])
  @@index([messageId])
}

model Conversation {
  id              String   @id @default(cuid())
  userId          String
  title           String   @default("Nova conversa")
  providerId      String?
  modelId         String?
  projectId       String?
  engineVersion   String?
  forkedFromId    String?
  forkBoundarySeq BigInt?
  archived        Boolean  @default(false)
  shareToken      String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    Message[]
  attachments ConversationAttachment[]
  canvases    Canvas[]
  artifacts   ProjectArtifact[]        @relation("ArtifactSourceConversation")
  usageLogs   UsageLog[]
  events      SessionEvent[]
  agentRuns   AgentRun[]
  forkedFrom  Conversation?            @relation("ConversationForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks       Conversation[]           @relation("ConversationForks")

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([forkedFromId])
}

model SessionEvent {
  seq            BigInt   @id @default(autoincrement())
  id             String   @unique @default(cuid())
  conversationId String
  runId          String?
  turnId         String?
  stepId         String?
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run          AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([conversationId, seq])
  @@index([runId, seq])
  @@index([turnId])
}

model AgentRun {
  id               String    @id @default(cuid())
  conversationId   String
  userId           String
  parentRunId      String?
  idempotencyKey   String?
  status           String    @default("queued")
  providerId       String?
  modelId          String?
  stepCount        Int       @default(0)
  maxSteps         Int       @default(16)
  subagentDepth    Int       @default(0)
  maxSubagentDepth Int       @default(2)
  leaseToken       String?
  leaseVersion     Int       @default(0)
  leaseExpiresAt   DateTime?
  error            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentRun    AgentRun?      @relation("AgentRunChildren", fields: [parentRunId], references: [id], onDelete: SetNull)
  children     AgentRun[]     @relation("AgentRunChildren")
  events       SessionEvent[]
  approvals    ToolApproval[]

  @@unique([conversationId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([conversationId, status])
  @@index([parentRunId])
}

model ToolApproval {
  id         String    @id @default(cuid())
  userId     String
  runId      String
  toolCallId String
  toolName   String
  args       Json
  risk       String
  reason     String
  status     String    @default("pending")
  decision   String?
  response   Json?
  operationKey String  @unique
  result     Json?
  stepNumber Int
  executionToken String?
  executionStartedAt DateTime?
  executionExpiresAt DateTime?
  attemptCount Int @default(0)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, toolCallId])
  @@index([userId, status, createdAt])
  @@index([status, executionExpiresAt])
}

model HarnessPluginConfig {
  id        String   @id @default(cuid())
  userId    String
  pluginId  String
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pluginId])
  @@index([userId, enabled])
}

model McpServer {
  id               String   @id @default(cuid())
  userId           String
  name             String
  url              String
  encryptedHeaders String?
  status           String   @default("active")
  toolsCache       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, status])
}

model HarnessSkill {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  name        String
  description String?
  content     String
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, name])
  @@index([userId, enabled])
  @@index([projectId, enabled])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  parts          Json?
  parentId       String?
  branchIndex    Int      @default(0)
  createdAt      DateTime @default(now())

  conversation Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  ConversationAttachment[]
  reactions    MessageReaction[]
  parent       Message?                 @relation("MessageBranches", fields: [parentId], references: [id], onDelete: SetNull)
  children     Message[]                @relation("MessageBranches")

  @@index([conversationId, createdAt])
  @@index([parentId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  type      String // "thumbs_up" | "thumbs_down"
  /// Nota curta opcional explicando a reação (ex.: por que a resposta foi ruim).
  note      String?
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  customInstructionsAbout String? // "What should the AI know about you?"
  customInstructionsStyle String? // "How should the AI respond?"
  accentColor             String? // accent preset id (lib/accent-colors.ts); null = default theme
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RoutingConfig {
  id                 String   @id @default(cuid())
  userId             String   @unique
  complexityEnabled  Boolean  @default(false)
  taskRoutingEnabled Boolean  @default(false)
  /// JSON: Record<string, {providerId: string, modelId: string, fallbacks?: Array<{providerId: string, modelId: string}>}> — keyed by tier name or task category
  tiers              Json     @default("{}")
  taskOverrides      Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBudget {
  id              String   @id @default(cuid())
  userId          String   @unique
  periodType      String   @default("monthly")
  limitUsd        Float?
  alertThreshold  Float    @default(0.8)
  blocksRequests  Boolean  @default(false)
  baselineModelId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConversationAttachment {
  id               String   @id @default(cuid())
  conversationId   String
  messageId        String?
  kind             String
  mimeType         String
  fileName         String
  byteSize         Int
  blob             Bytes
  extractedText    String?
  extractionStatus String
  createdAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([messageId])
}
